{
  "name": "rf-desktop",
  "version": "3.3.0",
  "description": "Reversed Front desktop application shell for the latest RF web build",
  "main": "index.js",
  "scripts": {
    "build": "cargo build --manifest-path desktop/Cargo.toml --locked --bin rf-desktop --release",
    "dev": "cargo run --manifest-path desktop/Cargo.toml --locked --bin rf-desktop",
    "bundle": "node scripts/validate-release.cjs --resources && node scripts/bundle.cjs",
    "mod:build": "webpack --config web/mod/webpack.config.cjs --mode production",
    "validate:release": "node scripts/validate-release.cjs",
    "test:native-bridge": "node --test scripts/native-bridge.test.cjs",
    "test:tooling": "node --test scripts/release-tooling.test.cjs",
    "test": "npm run validate:release && npm run test:native-bridge && npm run test:tooling && cargo test --manifest-path desktop/Cargo.toml --locked --no-default-features --lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoLinOwO/ReversedFront.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "js-yaml": "^4.1.1"
  },
  "bugs": {
    "url": "https://github.com/MoLinOwO/ReversedFront/issues"
  },
  "homepage": "https://github.com/MoLinOwO/ReversedFront#readme",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@crabnebula/packager": "0.11.2",
    "babel-loader": "^10.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
